# Database
DATABASE_URL=postgresql://user:password@localhost:5432/betting_creator_tracker

# LLM (use one or both)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Apify (social scraping)
APIFY_API_TOKEN=

# Reddit API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BettingCreatorTracker/1.0

# YouTube Data API
YOUTUBE_API_KEY=

# Sports/Odds data
THE_ODDS_API_KEY=
ODDS_API_ENABLED=false

# Security
ADMIN_API_KEY=  # Required for write endpoints (POST/PUT/DELETE)
ALLOWED_ORIGINS=http://localhost:3000  # Comma-separated, add Vercel domain for production

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
FAILED_EXTRACTION_NOTIFY=true  # Send alerts on failed extractions
